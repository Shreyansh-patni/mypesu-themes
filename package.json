{
  "name": "mypesu-themes",
  "version": "0.1.0",
  "description": "Your Academy. Your Style. Independent browser extension for customizing PESU Academy's visual appearance.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build -b chrome --mv3",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.1.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^8.3.8",
    "vitest": "^3.0.5",
    "wxt": "^0.21.5"
  }
