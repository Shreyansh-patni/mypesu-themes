{
  "name": "mypesu-themes",
  "version": "0.1.0",
  "description": "Your Academy. Your Style. Independent browser extension for customizing PESU Academy's visual appearance.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build -b chrome --mv3",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.5",
    "wxt": "^0.21.5"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "^5.2.0"
    }
  }
}
